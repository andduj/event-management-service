<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Application\Extensions\**" />
    <Compile Remove="Application\Filters\**" />
    <Compile Remove="Presentation\Extensions\**" />
    <Compile Remove="Presentation\Middleware\**" />
    <Content Remove="Application\Extensions\**" />
    <Content Remove="Application\Filters\**" />
    <Content Remove="Presentation\Extensions\**" />
    <Content Remove="Presentation\Middleware\**" />
    <EmbeddedResource Remove="Application\Extensions\**" />
    <EmbeddedResource Remove="Application\Filters\**" />
    <EmbeddedResource Remove="Presentation\Extensions\**" />
    <EmbeddedResource Remove="Presentation\Middleware\**" />
    <None Remove="Application\Extensions\**" />
    <None Remove="Application\Filters\**" />
    <None Remove="Presentation\Extensions\**" />
    <None Remove="Presentation\Middleware\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Дерево папок как в EventManagement.Event (только структура, без файлов из Event). -->
  <ItemGroup>
    <Folder Include="Application\" />
    <Folder Include="Application\DTOs\" />
    <Folder Include="Application\Interfaces\" />
    <Folder Include="Application\Requests\" />
    <Folder Include="Application\Services\" />
    <Folder Include="Data\" />
    <Folder Include="Data\Interfaces\" />
    <Folder Include="Data\Repositories\" />
    <Folder Include="Exceptions\" />
    <Folder Include="Infrastructure\" />
    <Folder Include="Presentation\" />
    <Folder Include="Presentation\Controllers\" />
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
