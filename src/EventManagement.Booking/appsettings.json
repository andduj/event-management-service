{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=bookings;Username=;Password="
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "BookingProcessing": {
    "PollingIntervalSeconds": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "bookings-service"
  },
  "Jwt": {
    "Secret": "EventManagementSprint8DevSecretKey_Min32Chars!",
    "Issuer": "EventManagement.Auth",
    "Audience": "EventManagement",
    "LifetimeMinutes": 60
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}
