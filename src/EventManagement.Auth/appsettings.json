{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5437;Database=auth;Username=;Password="
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "auth-api"
  },
  "Jwt": {
    "Secret": "EventManagementSprint8DevSecretKey_Min32Chars!",
    "Issuer": "EventManagement.Auth",
    "Audience": "EventManagement",
    "LifetimeMinutes": 60
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}
